# Copy to .env and adjust. Never commit .env.
CRISOL_ENVIRONMENT=development
CRISOL_LOG_LEVEL=INFO
# text | json
CRISOL_LOG_FORMAT=text
CRISOL_API_HOST=127.0.0.1
CRISOL_API_PORT=8000

# --- Coming in later phases ---
# Phase 2 (PostgreSQL + pgvector in Docker, port 5433 to avoid clashing with local Postgres)
# CRISOL_DATABASE_URL=postgresql+psycopg://crisol:crisol@localhost:5433/crisol
# Phase 6/9 (Ollama)
# CRISOL_OLLAMA_BASE_URL=http://localhost:11434
# CRISOL_EMBEDDING_MODEL=qwen3-embedding:0.6b
# CRISOL_LLM_MODEL=qwen3:4b
